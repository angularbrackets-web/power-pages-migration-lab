{% comment %}
  Web template: "Northbank Legacy Page List"

  Deliberately written in the old standard-data-model (Adxstudio-era) style
  to exercise the data model migration. It queries the adx_webpage table
  directly with FetchXML, including the custom column nb_legacynote.
  After a move to the enhanced data model, web pages live in
  powerpagecomponent (component type 2), so this query has to be rewritten.

  FetchXML elements use explicit closing tags, not self-closing ones, as the
  Power Pages fetchxml tag documentation asks.
{% endcomment %}

{% fetchxml legacy_pages %}
<fetch version="1.0" mapping="logical" count="20">
  <entity name="adx_webpage">
    <attribute name="adx_name"></attribute>
    <attribute name="adx_partialurl"></attribute>
    <attribute name="nb_legacynote"></attribute>
    <order attribute="adx_name" descending="false"></order>
    <filter type="and">
      <condition attribute="adx_websiteid" operator="eq" value="{{ website.id }}"></condition>
      <condition attribute="statecode" operator="eq" value="0"></condition>
    </filter>
  </entity>
</fetch>
{% endfetchxml %}

<h2>Pages on this site (adx_webpage)</h2>
{% if legacy_pages.results.entities.size > 0 %}
  <ul>
    {% for legacy in legacy_pages.results.entities %}
      <li>
        {{ legacy.adx_name | escape }} ({{ legacy.adx_partialurl | escape }})
        {% if legacy.nb_legacynote %} - {{ legacy.nb_legacynote | escape }}{% endif %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p>The query returned no rows.</p>
{% endif %}
